job "{{ job_name | default('tml-interaction') }}" {
  datacenters = {{ nomad_datacenters | default(['dc1']) | to_json }}
  namespace   = "{{ nomad_namespace | default('default') }}"
  type        = "service"

  group "interaction-group" {
    count = 1

    restart {
      attempts = 5
      interval = "5m"
      delay    = "15s"
      mode     = "delay"
    }

    reschedule {
      delay          = "30s"
      delay_function = "exponential"
      max_delay      = "10m"
      unlimited      = true
    }

    network {
      port "moshi_http" {}
      port "llama_http" {}
    }

    volume "models" {
      type      = "host"
      source    = "models"
      read_only = true
    }

    service {
      name    = "tml-interaction-moshi"
      port    = "moshi_http"
      address = "${attr.unique.network.ip-address}"

      tags = [
        "traefik.enable=true",
        "traefik.http.routers.tml-interaction-moshi.rule=Host(`interaction.{{ mesh_domain | default('local.mesh') }}`)",
        "traefik.http.routers.tml-interaction-moshi.entrypoints=websecure",
        "traefik.http.routers.tml-interaction-moshi.tls=true"
      ]

      check {
        type     = "http"
        path     = "/"
        interval = "10s"
        timeout  = "2s"

        check_restart {
          limit           = 3
          grace           = "90s"
          ignore_warnings = false
        }
      }
    }

    service {
      name    = "tml-interaction-llama"
      port    = "llama_http"
      address = "${attr.unique.network.ip-address}"

      check {
        type     = "http"
        path     = "/health"
        interval = "10s"
        timeout  = "2s"

        check_restart {
          limit           = 3
          grace           = "90s"
          ignore_warnings = false
        }
      }
    }

    task "llama-cpp" {
      driver = "docker"

      config {
        image = "{{ container_registry | default('ghcr.io') }}/ggerganov/llama.cpp:server"
        ports = ["llama_http"]

        args = [
          "--host", "0.0.0.0",
          "--port", "${NOMAD_PORT_llama_http}",
          "--model", "/models/{{ model.filename | default('inkling-UD-IQ1_S.gguf') }}",
          "--ctx-size", "4096",
          "--n-predict", "-1",
          "--batch-size", "512",
          "--n-gpu-layers", "99"
        ]
      }

      volume_mount {
        volume      = "models"
        destination = "/models"
        read_only   = true
      }

      resources {
        memory = {{ model.memory_mb | default(16384) }}
        {% if enable_gpu | default(true) %}
        device "gpu" {
          count = 1
        }
        {% endif %}
      }
    }

    task "moshi-rust" {
      driver = "raw_exec"

      lifecycle {
        hook    = "prestart"
        sidecar = false
      }

      artifact {
        source      = "http://{{ cluster_ip | default('100.64.0.1') }}:{{ ipfs_gateway_port | default(8080) }}/ipfs/{{ moshi_rust_ipfs_cid | default('') }}"
        destination = "local/moshi-rust.tar"
        mode        = "file"
      }

      config {
        command = "docker"
        args    = ["load", "-i", "local/moshi-rust.tar"]
      }
    }

    task "moshi-rust-server" {
      driver = "docker"

      config {
        image = "moshi-rust:latest"
        ports = ["moshi_http"]
      }

      env {
        ADDR = "0.0.0.0"
        PORT = "${NOMAD_PORT_moshi_http}"
        # Connect to the local llama-cpp task using Nomad dynamic port assignments
        LM_MODEL_ENDPOINT = "http://${NOMAD_ADDR_llama_http}/v1"
        LLAMA_ENDPOINT = "http://${NOMAD_ADDR_llama_http}/v1"
        OPENAI_API_BASE = "http://${NOMAD_ADDR_llama_http}/v1"
      }

      resources {
        memory = 2048
      }
    }
  }
}

job "tool-server" {
  datacenters = {{ nomad_datacenters | default(['dc1']) | to_json }}
  type        = "service"
  priority    = 80

  # ==========================================
  # CORE GROUP
  # ==========================================
  group "tool-server-core" {
    count = 1

    network {
      port "http" {}
    }

    {% set image_cid = tool_server_core_ipfs_cid %}
    {% set image_tar_name = 'tool_server_core' %}
    {% include 'load_image_task.nomad.j2' %}

    volume "cluster-infra" {
      type      = "host"
      source    = "cluster-infra"
      read_only = true
    }

    volume "mcp-config" {
      type      = "host"
      source    = "mcp-config"
      read_only = false
    }

    restart {
      attempts = 5
      interval = "5m"
      delay    = "15s"
      mode     = "delay"
    }

    task "tool-server-core-task" {
      driver = "docker"

      config {
        image = "tool-server-core:local"
        force_pull = false
        ports = ["http"]

        # Volatile RAM disk for workspace
        mounts = [
          {
            type   = "tmpfs"
            target = "/opt/cluster-infra"
            tmpfs_options = {
              size = 1073741824 # 1GB
            }
          }
        ]

        volumes = [
          # Docker socket for CodeRunnerTool
          "/var/run/docker.sock:/var/run/docker.sock"
        ]

        command = "uvicorn"
        args = ["app:app", "--host", "0.0.0.0", "--port", "${NOMAD_PORT_http}"]
      }

      volume_mount {
        volume      = "cluster-infra"
        destination = "/mnt/host_repo"
        read_only   = true
      }

      volume_mount {
        volume      = "mcp-config"
        destination = "/opt/mcp"
        read_only   = false
      }

      env {
        TOOL_SERVER_ROLE    = "core"
        TOOL_SERVER_API_KEY = "{{ openai_api_key }}"
        HA_URL              = "{{ env_ha_url | default('') }}"
        HA_TOKEN            = "{{ env_ha_token | default('') }}"
        GITHUB_TOKEN        = "{{ github_token | default('') }}"
        GIT_USERNAME        = "{{ git_username | default('Pipecat Agent') }}"
        GIT_EMAIL           = "{{ git_email | default('agent@pipecat.ai') }}"
      }

      resources {
        cpu    = 500
        memory = 512
      }

      service {
        name    = "tool-server-core"
        port    = "http"
        address = "${attr.unique.network.ip-address}"
        tags    = ["tool-server-core", "http"]

        check {
          type     = "http"
          path     = "/health"
          check_restart {
            limit           = 3
            grace           = "90s"
            ignore_warnings = false
          }
          interval = "15s"
          timeout  = "5s"
        }
      }
    }
  }

  # ==========================================
  # BROWSER GROUP
  # ==========================================
  group "tool-server-browser" {
    count = 1

    network {
      port "http" {}
    }

    {% set image_cid = tool_server_browser_ipfs_cid %}
    {% set image_tar_name = 'tool_server_browser' %}
    {% include 'load_image_task.nomad.j2' %}

    restart {
      attempts = 5
      interval = "5m"
      delay    = "15s"
      mode     = "delay"
    }

    task "tool-server-browser-task" {
      driver = "docker"

      config {
        image    = "tool-server-browser:local"
        force_pull = false
        ports    = ["http"]
        shm_size = 1073741824 # 1 GB

        command = "uvicorn"
        args = ["app:app", "--host", "0.0.0.0", "--port", "${NOMAD_PORT_http}"]
      }

      env {
        TOOL_SERVER_ROLE    = "browser"
        TOOL_SERVER_API_KEY = "{{ openai_api_key }}"
      }

      resources {
        cpu    = 1000
        memory = 2048
      }
      
      service {
        name    = "tool-server-browser"
        port    = "http"
        address = "${attr.unique.network.ip-address}"
        tags    = ["tool-server-browser", "http"]

        check {
          type     = "http"
          path     = "/health"
          check_restart {
            limit           = 3
            grace           = "90s"
            ignore_warnings = false
          }
          interval = "15s"
          timeout  = "5s"
        }
      }
    }
  }

  # ==========================================
  # VISION GROUP
  # ==========================================
  group "tool-server-vision" {
    count = 1

    network {
      port "http" {}
    }

    {% set image_cid = tool_server_vision_ipfs_cid %}
    {% set image_tar_name = 'tool_server_vision' %}
    {% include 'load_image_task.nomad.j2' %}

    volume "cluster-infra" {
      type      = "host"
      source    = "cluster-infra"
      read_only = true
    }

    restart {
      attempts = 5
      interval = "5m"
      delay    = "15s"
      mode     = "delay"
    }

    task "tool-server-vision-task" {
      driver = "docker"

      config {
        image = "tool-server-vision:local"
        force_pull = false
        ports = ["http"]

        command = "uvicorn"
        args = ["app:app", "--host", "0.0.0.0", "--port", "${NOMAD_PORT_http}"]
      }

      volume_mount {
        volume      = "cluster-infra"
        destination = "/mnt/host_repo"
        read_only   = true
      }

      env {
        TOOL_SERVER_ROLE    = "vision"
        TOOL_SERVER_API_KEY = "{{ openai_api_key }}"
      }

      resources {
        cpu    = 1500
        memory = 4096
      }

      service {
        name    = "tool-server-vision"
        port    = "http"
        address = "${attr.unique.network.ip-address}"
        tags    = ["tool-server-vision", "http"]

        check {
          initial_status = "warning"
          type     = "http"
          path     = "/health"
          check_restart {
            limit           = 3
            grace           = "180s" # Longer grace for heavy ML imports
            ignore_warnings = false
          }
          interval = "20s"
          timeout  = "10s"
        }
      }
    }
  }
}

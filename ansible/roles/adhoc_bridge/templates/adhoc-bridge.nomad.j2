job "adhoc-bridge" {
  datacenters = {{ nomad_datacenters | default(['dc1']) | to_json }}
  # Changed from system to service with count = 1 to prevent round-robin across unique in-memory PINs
  type        = "service"
  priority    = 50

  group "mdns-listener" {
    count = 1
    network {
      mode = "host"
      port "http" {
        static = 5555 # Ad-hoc PAIR-style bridge port
      }
    }

    service {
      name = "adhoc-bridge"
      port = "http"

      tags = [
        "adhoc-bridge",
        "http",
        "traefik.enable=true",
        "traefik.http.routers.adhoc-bridge.rule=PathPrefix(`/pair`)",
        "traefik.http.routers.adhoc-bridge.entrypoints=websecure",
        "traefik.http.routers.adhoc-bridge.tls=true"
      ]

      check {
        type     = "tcp"
        interval = "10s"
        timeout  = "2s"
      }
    }

    task "mdns-agent" {
      driver = "raw_exec"

      env {
        CONSUL_HTTP_TOKEN = "{{ consul_bootstrap_token }}"
        CONSUL_HTTP_ADDR  = "https://{{ cluster_ip | default('127.0.0.1') }}:{{ consul_https_port | default(8501) }}"
        NOMAD_NODE_ID     = "${node.unique.id}"
        NOMAD_NODE_NAME   = "${node.unique.name}"
      }

      config {
        command = "/usr/bin/python3"
        args    = ["local/mdns_bridge.py"]
      }

      template {
        data = <<EOH
import sys
import time
import socket
import threading
from http.server import HTTPServer, BaseHTTPRequestHandler
import json
import random

PIN_CODE = str(random.randint(100000, 999999))
print(f"\n======================================")
print(f"Ad-Hoc Bridge PIN Code: {PIN_CODE}")
print(f"======================================\n")

# Ephemeral PIN logic:
# Implement a basic rate limit dictionary mapping IP -> (attempts, last_attempt_time)
rate_limits = {}
MAX_ATTEMPTS = 5
LOCKOUT_TIME = 60 # seconds

class BridgeHandler(BaseHTTPRequestHandler):
    def check_rate_limit(self, client_ip):
        now = time.time()
        if client_ip in rate_limits:
            attempts, last_time = rate_limits[client_ip]
            if attempts >= MAX_ATTEMPTS:
                if now - last_time < LOCKOUT_TIME:
                    return False
                else:
                    # Reset lockout
                    rate_limits[client_ip] = (0, now)
        return True

    def record_attempt(self, client_ip, success):
        now = time.time()
        if success:
            if client_ip in rate_limits:
                del rate_limits[client_ip]
        else:
            if client_ip in rate_limits:
                attempts, _ = rate_limits[client_ip]
                rate_limits[client_ip] = (attempts + 1, now)
            else:
                rate_limits[client_ip] = (1, now)

    def do_POST(self):
        # Support X-Forwarded-For if routed through Traefik proxy
        forwarded_for = self.headers.get('X-Forwarded-For')
        if forwarded_for:
            client_ip = forwarded_for.split(',')[0].strip()
        else:
            client_ip = self.client_address[0]

        if self.path == '/pair':
            if not self.check_rate_limit(client_ip):
                self.send_response(429)
                self.send_header('Content-type', 'application/json')
                self.end_headers()
                self.wfile.write(json.dumps({"status": "error", "message": "Rate limit exceeded"}).encode('utf-8'))
                return

            content_length = int(self.headers['Content-Length'])
            post_data = self.rfile.read(content_length)
            try:
                data = json.loads(post_data.decode('utf-8'))
                if data.get('pin') == PIN_CODE:
                    # In a real implementation, this would issue Headscale pre-auth keys
                    # or configure Tailscale directly.
                    # We would also capture the remote peer's details for peer_gateway tracking here.
                    self.record_attempt(client_ip, True)
                    peer_ip = data.get('peer_ip', client_ip)
                    peer_port = data.get('peer_port', 11434)
                    peer_engine = data.get('peer_engine', 'ollama')
                    print(f"Paired successfully with {peer_ip}:{peer_port} ({peer_engine})")

                    response = {"status": "success", "message": "Paired successfully. Headscale pre-auth key would be returned here."}
                    self.send_response(200)
                else:
                    self.record_attempt(client_ip, False)
                    response = {"status": "error", "message": "Invalid PIN"}
                    self.send_response(403)
            except Exception as e:
                response = {"status": "error", "message": str(e)}
                self.send_response(400)

            self.send_header('Content-type', 'application/json')
            self.end_headers()
            self.wfile.write(json.dumps(response).encode('utf-8'))

def run_server():
    # Bind to 0.0.0.0 so Consul health checks and Traefik can route to it via the host LAN IP.
    # We rely on Traefik for public ingress and host firewalls to prevent direct port 5555 access.
    server_address = ('0.0.0.0', 5555)
    httpd = HTTPServer(server_address, BridgeHandler)
    print(f"Starting Ad-Hoc PAIR bridge on 0.0.0.0:5555...")
    httpd.serve_forever()

if __name__ == "__main__":
    run_server()
EOH
        destination = "local/mdns_bridge.py"
        perms       = "755"
      }

      resources {
        cpu    = 100
        memory = 64
      }
    }
  }
}

{% set controller_host = (groups.get('controller_nodes', []) | first) | default(inventory_hostname, true) %}
{% set controller_ip = hostvars.get(controller_host, {}).get('ansible_host') | default(hostvars.get(controller_host, {}).get('ansible_facts', {}).get('default_ipv4', {}).get('address')) | default('127.0.0.1') %}
http:
  middlewares:
    authentik:
      forwardAuth:
        address: "http://{{ controller_ip }}:9000/outpost.goauthentik.io/auth/traefik"
        trustForwardHeader: true
        authResponseHeaders:
          - X-authentik-username
          - X-authentik-groups
          - X-authentik-email
          - X-authentik-name
          - X-authentik-uid
          - X-authentik-jwt
          - X-authentik-meta-jwks
          - X-authentik-meta-outpost
          - X-authentik-meta-provider
          - X-authentik-meta-app
          - X-authentik-meta-version

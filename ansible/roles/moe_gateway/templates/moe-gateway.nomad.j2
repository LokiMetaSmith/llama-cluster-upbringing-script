job "moe-gateway" {
  datacenters = {{ nomad_datacenters | default(['dc1']) | to_json }}
  type        = "service"
  priority    = 80

  group "gateway" {
    count = 1

    network {
      mode = "host"
      port "http" {
        static = {{ router_port | default(8081) }}
      }
    }

    service {
      name = "moe-gateway"
      port = "http"
      tags = ["moe-gateway", "http"]

      check {
        type         = "http"
        path         = "/health"
        interval     = "10s"
        timeout      = "2s"

        check_restart {
          limit = 3
          grace = "30s"
          ignore_warnings = false
        }
      }
    }

    task "gateway-server" {
      driver = "raw_exec"

      env {
        CONSUL_HTTP_TOKEN = "{{ consul_bootstrap_token }}"
        CONSUL_HTTP_ADDR  = "https://{{ cluster_ip | default('127.0.0.1') }}:{{ consul_https_port | default(8501) }}"
      }

      config {
        command = "{{ pipecat_app_dir }}/venv/bin/python"
        args    = ["{{ pipecat_app_dir }}/moe_gateway/gateway.py"]
      }

      template {
        data = <<EOH
#!/bin/bash
# We can add any startup logic here if needed in the future.
EOH
        destination = "local/run.sh"
        perms       = "755"
      }

      resources {
        cpu    = 500
        memory = 512
      }
    }
  }
}

job "world-model-service" {
  datacenters = {{ nomad_datacenters | default(['dc1']) | to_json }}
  type        = "service"

  group "world-model" {
    count = 1

    volume "world_model_storage" {
      type      = "host"
      read_only = false
      source    = "world_model_storage"
    }

    volume "nomad_tls" {
      type      = "host"
      read_only = true
      source    = "nomad_tls"
    }

    network {
      mode = "host"
      port "http" {}
    }

    task "server" {
      driver = "docker"

      config {
        image   = "world-model-service:local"
        force_pull = false
      }

      volume_mount {
        volume      = "world_model_storage"
        destination = "/data"
        read_only   = false
      }

      env {
      #  MQTT_HOST = "{{ cluster_ip }}"
        MQTT_HOST = "{{ advertise_ip }}"
        MQTT_PORT = "{{ mqtts_port | default(8883) }}"
        MQTT_CA_CERT = "/etc/tls/ca.pem"
        MQTT_CLIENT_CERT = "/etc/tls/mqtt_client.cert.pem"
        MQTT_CLIENT_KEY = "/etc/tls/mqtt_client.key.pem"
      #  CONSUL_HOST = "{{ cluster_ip }}"
        CONSUL_HOST = "{{ advertise_ip }}"
        CONSUL_PORT = "{{ consul_http_port }}"
      #  NOMAD_ADDR = "{{ nomad_protocol | default('https') }}://{{ cluster_ip }}:{{ nomad_http_port }}"
        NOMAD_ADDR = "https://{{ advertise_ip }}:{{ nomad_http_port }}"
      }

      volume_mount {
        volume      = "nomad_tls"
        destination = "/etc/tls"
        read_only   = true
      }

      resources {
        cpu    = 250
        memory = 512
      }

      service {
        name = "world-model-api"
        tags = ["api", "world-model"]
        port = "http"

        check {
          type     = "script"
          name     = "alive"
          command  = "python"
          args     = ["-c", "import os, urllib.request; port = os.getenv('NOMAD_PORT_http'); urllib.request.urlopen(f'http://127.0.0.1:{port}/health')"]
          interval = "15s"
          timeout  = "10s"
        }
      }
    }
  }
}

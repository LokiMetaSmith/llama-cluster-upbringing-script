FROM docker.io/library/debian:12-slim

# Force apt to use IPv4 only to avoid unreachable IPv6 DNS routing issues during build
RUN echo "Acquire::ForceIPv4 \"true\";" > /etc/apt/apt.conf.d/99force-ipv4

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        isc-dhcp-server \
        tftpd-hpa \
        nginx \
        supervisor \
        && rm -rf /var/lib/apt/lists/*

# Configure Supervisor to manage the services
RUN mkdir -p /var/log/supervisor /var/log/nginx /var/lib/dhcp && \
    touch /var/lib/dhcp/dhcpd.leases && \
    chmod -R 777 /var/log/nginx /var/lib/dhcp && \
    ln -sf /dev/stdout /var/log/nginx/access.log && \
    ln -sf /dev/stderr /var/log/nginx/error.log

COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Setup Nginx to listen on custom PXE HTTP port (default 8093) and run in foreground
ARG PXE_HTTP_PORT=8093
ENV PXE_HTTP_PORT=${PXE_HTTP_PORT}
RUN sed -i 's/listen 80 default_server;/listen 8093 default_server;/g' /etc/nginx/sites-available/default 2>/dev/null || true && \
    sed -i 's/listen \[::\]:80 default_server;/listen [::]:8093 default_server;/g' /etc/nginx/sites-available/default 2>/dev/null || true && \
    echo "daemon off;" >> /etc/nginx/nginx.conf

CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]

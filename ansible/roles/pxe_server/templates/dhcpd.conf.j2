option domain-name "cluster.local";
option domain-name-servers {{ pxe_dns | default('1.1.1.1, 8.8.8.8') }};

default-lease-time 600;
max-lease-time 7200;

ddns-update-style none;

authoritative;

# iPXE chainloading logic
# See: https://ipxe.org/howto/dhcpd
option client-arch code 93 = unsigned integer 16;

log-facility local7;

subnet {{ pxe_subnet | default('192.168.1.0') }} netmask {{ pxe_netmask | default('255.255.255.0') }} {
  range {{ pxe_range_start | default('192.168.1.200') }} {{ pxe_range_end | default('192.168.1.240') }};
  option routers {{ pxe_router | default('192.168.1.1') }};

  # Point PXE clients to the TFTP server on the local physical network
  next-server {{ pxe_server_ip | default(ansible_facts.default_ipv4.address | default(ansible_default_ipv4.address | default('192.168.1.148'))) }};

  if exists user-class and option user-class = "iPXE" {
    # Client is already running iPXE - download the boot script over HTTP
    filename "http://{{ pxe_server_ip | default(ansible_facts.default_ipv4.address | default(ansible_default_ipv4.address | default('192.168.1.148'))) }}/boot.ipxe";
  } elsif option client-arch = 00:07 or option client-arch = 00:09 {
    # UEFI 64-bit client
    filename "ipxe.efi";
  } else {
    # BIOS client (e.g. Intel UNDI 2.1)
    filename "undionly.kpxe";
  }
}

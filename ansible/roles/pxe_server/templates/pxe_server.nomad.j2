job "pxe-server" {
  datacenters = ["dc1"]
  type = "service"

  group "pxe-group" {
    count = 1

    network {
      mode = "host"
      port "dhcp" {
        static = 67
      }
      port "tftp" {
        static = 69
      }
      port "http" {
        static = 80
      }
    }

    {% set image_cid = pxe_image_cid %}
    {% set image_tar_name = 'pxe-server' %}
    {% include 'load_image_task.nomad.j2' %}

    task "pxe-server" {
      driver = "docker"

      config {
        image        = "pipecat/pxe-server:local"
        force_pull   = false
        network_mode = "host"

        volumes = [
          "/srv/tftp:/srv/tftp:ro",
          "/var/www/html:/var/www/html:ro",
          "/etc/dhcp/dhcpd.conf:/etc/dhcp/dhcpd.conf:ro"
        ]
      }

      resources {
        cpu    = 500
        memory = 256
      }

      service {
        name = "pxe-http"
        port = "http"
        check {
          name     = "alive"
          type     = "http"
          path     = "/boot.ipxe"
          interval = "10s"
          timeout  = "2s"
        }
      }
    }
  }
}

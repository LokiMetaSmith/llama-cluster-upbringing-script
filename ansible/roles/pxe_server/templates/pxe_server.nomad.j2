job "pxe-server" {
  datacenters = ["dc1"]
  type = "service"

  group "pxe-group" {
    count = 1

    network {
      mode = "host"
      port "dhcp" {
        static = 67
      }
      port "tftp" {
        static = 69
      }
      port "http" {
        static = 80
      }
    }

    task "load_image" {
      driver = "raw_exec"

      lifecycle {
        hook    = "prestart"
        sidecar = false
      }

      config {
        command = "/bin/bash"
        args    = ["-c", "export IPFS_PATH=/opt/unified_fs_backend/ipfs/pipecat && ipfs cat {{ pxe_image_cid }} | docker load"]
      }

      resources {
        cpu    = 100
        memory = 128
      }
    }

    task "pxe-server" {
      driver = "docker"

      config {
        image = "pipecat/pxe-server:latest"
        network_mode = "host"

        volumes = [
          "/srv/tftp:/srv/tftp:ro",
          "/var/www/html:/var/www/html:ro",
          "/etc/dhcp/dhcpd.conf:/etc/dhcp/dhcpd.conf:ro"
        ]
      }

      resources {
        cpu    = 500
        memory = 256
      }

      service {
        name = "pxe-http"
        port = "http"
        check {
          name     = "alive"
          type     = "http"
          path     = "/boot.ipxe"
          interval = "10s"
          timeout  = "2s"
        }
      }
    }
  }
}

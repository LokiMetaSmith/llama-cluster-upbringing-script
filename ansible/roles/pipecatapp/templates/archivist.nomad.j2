job "archivist" {
  datacenters = {{ nomad_datacenters | default(['dc1']) | to_json }}
  type        = "service"
  priority    = 80

  group "archivist-group" {
    count = 1

    network {
      mode = "host"
      port "http" {
        static = {{ archivist_port }}
      }
    }

    service {
      name     = "archivist-api"
      port     = "http"
      provider = "consul"
      address  = "${attr.unique.network.ip-address}"
      tags     = ["archivist", "memory"]

      check {
        type     = "http"
        path     = "/health"
        check_restart {
          limit = 3
          grace = "90s"
          ignore_warnings = false
        }
        interval = "10s"
        timeout  = "2s"
      }
    }

    restart {
      attempts = 5
      interval = "5m"
      delay    = "15s"
      mode     = "delay"
    }

    task "archivist-task" {
      driver = "raw_exec"

      env {
        ARCHIVIST_PORT = "${NOMAD_PORT_http}"
        DB_PATH        = "{{ target_user_home }}/.config/pipecat/pypicat_memory.db"
        INDEX_DIR      = "{{ target_user_home }}/.config/pipecat/archivist_data"
        CONSUL_HOST    = "{{ ansible_facts['default_ipv4']['address'] }}"
        CONSUL_PORT    = "8500"
        CONSUL_HTTP_TOKEN = "{{ consul_bootstrap_token | default('') }}"
        HOST_IP        = "0.0.0.0"
      }

      config {
        command = "/opt/pipecatapp/start_archivist.sh"
      }

      resources {
        cpu    = 1000 # 1 GHz
        memory = 2048 # 2 GB for BGE-Large
      }
    }
  }
}

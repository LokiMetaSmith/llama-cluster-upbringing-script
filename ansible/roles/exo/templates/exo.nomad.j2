job "exo" {
  datacenters = {{ nomad_datacenters | default(['dc1']) | to_json }}
  type        = "service"

  group "exo" {
    count = 1

    network {
      mode = "host"
      port "http" {
        static = {{ exo_port }}
      }
    }

    {% set image_cid = exo_ipfs_cid %}

    {% set image_tar_name = 'exo' %}

    {% include 'load_image_task.nomad.j2' %}

    task "exo" {
      driver = "containerd-driver"

      config {
        image = "{{ exo_docker_image_name }}"
        force_pull = false # We build locally

        # In host mode, ports are mapped directly
        args = [
          "run",
          "--host", "0.0.0.0",
          "--port", "{{ exo_port }}",
          "{{ exo_model }}"
        ]

        # Use direct bind mounts for simplicity
        mounts = [
          {
            type     = "bind"
            source   = "{{ exo_data_dir }}"
            target   = "/root/.cache/huggingface"
            readonly = false
          },
          {
            type     = "bind"
            source   = "{{ exo_home_dir }}"
            target   = "/root/.exo"
            readonly = false
          }
        ]
      }

      resources {
        cpu = 1000 # MHz
        memory = 1024 # MB - adjust based on model
      }

      service {
        name = "exo"
        port = "http"

        check {
          name     = "alive"
          type     = "http"
          path     = "/"
          interval = "10s"
          timeout  = "2s"
        }
      }

      env {
        HF_HOME = "/root/.cache/huggingface"
      }
    }
  }
}

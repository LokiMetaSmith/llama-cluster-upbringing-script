job "mcp-server" {
  datacenters = {{ nomad_datacenters | default(['dc1']) | to_json }}
  type = "service"

  group "mcp-server" {
    count = 1

    network {
      mode = "host"
      port "http" {}
    }


    volume "cluster-infra" {
      type      = "host"
      source    = "cluster-infra"
      read_only = true
    }

    volume "mcp-config" {
      type      = "host"
      source    = "mcp-config"
      read_only = false
    }

    {% if tool_server_ipfs_cid is defined and tool_server_ipfs_cid %}
    task "load-image" {
      driver = "raw_exec"
      lifecycle {
        hook    = "prestart"
        sidecar = false
      }

      artifact {
        source      = "http://{{ cluster_ip | default('100.64.0.1') }}:{{ ipfs_gateway_port | default(8092) }}/ipfs/{{ tool_server_ipfs_cid }}"
        destination = "local/tool-server.tar"
        mode        = "file"
      }

      config {
        command = "docker"
        args    = ["load", "-i", "local/tool-server.tar"]
      }
    }

    {% endif %}

    task "mcp-server" {
      driver = "docker"
      config {
        image = "{{ mcp_server_image }}"
        # force_pull = false # local image
        command = "uvicorn"
        args = ["app:app", "--host", "0.0.0.0", "--port", "${NOMAD_PORT_http}"]

        # Volatile RAM disk for workspace
        mounts = [
          {
            type   = "tmpfs"
            target = "/opt/cluster-infra"
            tmpfs_options = {
              size = 2147483648 # 2GB
            }
          }
        ]

        volumes = [
          "/var/run/docker.sock:/var/run/docker.sock"
        ]
      }

      volume_mount {
        volume      = "cluster-infra"
        destination = "/mnt/host_repo"
        read_only   = true
      }

      volume_mount {
        volume      = "mcp-config"
        destination = "/opt/mcp"
        read_only   = false
      }
      env {
        # Adapting to tool-server:local expectations
        TOOL_SERVER_API_KEY = "{{ jules_api_key }}"
        HA_URL              = "{{ env_ha_url | default('') }}"
        HA_TOKEN            = "{{ env_ha_token | default('') }}"
        GITHUB_TOKEN        = "{{ github_token | default('') }}"
        GIT_USERNAME        = "{{ git_username | default('Pipecat Agent') }}"
        GIT_EMAIL           = "{{ git_email | default('agent@pipecat.ai') }}"

        # Keep original env vars in case they are needed for other reasons,
        # or if the image is switched back to something else.
        JULES_API_KEY = "{{ jules_api_key }}"
        HOST          = "0.0.0.0"
        PORT          = "${NOMAD_PORT_http}"
      }

      service {
        name = "mcp-server"
        port = "http"
        tags = ["mcp"]

        check {
          type     = "http"
          path     = "/health"
          interval = "10s"
          timeout  = "2s"

          check_restart {
            limit = 3
            grace = "30s"
            ignore_warnings = false
          }
        }
      }
    }
  }
}

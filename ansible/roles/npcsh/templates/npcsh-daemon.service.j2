[Unit]
Description=Persistent npcsh / npcrs Agent Daemon
After=network.target

[Service]
Type=simple
User={{ npcsh_user | default('cluster') }}
Environment="LOCAL_INFERENCE_KEY={{ local_inference_key | default('sk-local-no-auth') }}"
RuntimeDirectory=npcsh
RuntimeDirectoryMode=0755
ExecStart=/usr/local/bin/npcsh-daemon --socket {{ npcsh_socket_path | default('/run/npcsh/daemon.sock') }}
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target

job "ipfs" {
  datacenters = {{ nomad_datacenters | default(['dc1']) | to_json }}
  type        = "system"

  group "ipfs" {
    ephemeral_disk {
      migrate = true
      size    = 200
      sticky  = true
    }

    network {
      port "swarm" {
        static = {{ ipfs_swarm_port | default(4001) }}
      }
      port "api" {
        static = {{ ipfs_api_port | default(5001) }}
      }
      port "gateway" {
        static = {{ ipfs_gateway_port | default(8092) }}
      }
    }

    restart {
      attempts = 10
      interval = "5m"
      delay    = "5s"
      mode     = "delay"
    }

    task "ipfs" {
      driver = "raw_exec"
      user   = "{{ target_user | default('pipecatapp') }}"

      logs {
        max_files     = 5
        max_file_size = 10
      }

      config {
        command = "/bin/bash"
        args = [
          "-c",
          "pkill -9 -u {{ target_user | default('pipecatapp') }} -f '^/usr/local/bin/ipfs daemon' || true; rm -f /opt/unified_fs_backend/ipfs/{{ ipfs_node_name | default('pipecat') }}/repo.lock /opt/unified_fs_backend/ipfs/{{ ipfs_node_name | default('pipecat') }}/api; exec /usr/local/bin/ipfs daemon --enable-gc --migrate"
        ]
      }

      env {
        IPFS_PATH = "/opt/unified_fs_backend/ipfs/{{ ipfs_node_name | default('pipecat') }}"
        HOME = "/opt/unified_fs_backend/ipfs/{{ ipfs_node_name | default('pipecat') }}"
        IPFS_PROFILE = "server"
        IPFS_CONFIG_Datastore_StorageMax = "10GB"
        IPFS_CONFIG_Experimental_FilestoreEnabled = "true"
        # Bind to 0.0.0.0 so that Nomad prestart tasks using cluster_ip or 127.0.0.1 can reach it
        IPFS_CONFIG_Addresses_Gateway = "/ip4/0.0.0.0/tcp/{{ ipfs_gateway_port | default(8092) }}"
        IPFS_CONFIG_Addresses_API = "/ip4/0.0.0.0/tcp/{{ ipfs_api_port | default(5001) }}"
      }

      resources {
        cpu    = 500
        memory = 1024
      }
    }
  }
}

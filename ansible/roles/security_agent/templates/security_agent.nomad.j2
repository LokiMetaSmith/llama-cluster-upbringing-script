job "security-agent" {
  datacenters = ["dc1"]
  type        = "service"

  group "security-agent" {
    count = 1

    # Pin to the controller node where the image was built
    constraint {
      attribute = "${attr.unique.hostname}"
      value     = "{{ inventory_hostname }}"
    }

    network {
      port "tcp" {
        to = 9000
      }
    }

    service {
      name = "security-agent"
      port = "tcp"

      check {
        type     = "tcp"
        interval = "10s"
        timeout  = "2s"
      }
    }

    volume "nomad_tls" {
      type      = "host"
      source    = "nomad_tls"
      read_only = true
    }

    task "security-agent" {
      driver = "docker"

      config {
        image = "local/security-agent:latest"
        ports = ["tcp"]
      }

      volume_mount {
        volume      = "nomad_tls"
        destination = "/etc/tls"
        read_only   = true
      }

      env {
        MQTT_BROKER     = "{{ cluster_ip | default('127.0.0.1') }}"
        MQTT_PORT       = "{{ mqtts_port | default(8883) }}"
        MQTT_CA_CERT    = "/etc/tls/ca.pem"
        MQTT_CLIENT_CERT = "/etc/tls/mqtt_client.cert.pem"
        MQTT_CLIENT_KEY = "/etc/tls/mqtt_client.key.pem"
        TCP_LISTEN_PORT = "9000"
      }

      resources {
        cpu    = 200
        memory = 256
      }
    }
  }
}

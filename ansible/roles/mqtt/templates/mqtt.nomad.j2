job "mqtt" {
  datacenters = {{ nomad_datacenters | default(['dc1']) | to_json }}
  type        = "service"
  priority    = 80

  group "mqtt-group" {
    count = 1

    network {
      mode = "host"
      port "mqtt" {
        static = {{ mqtt_port }}
      }
      port "mqtts" {
        static = {{ mqtts_port | default(8883) }}
      }
      port "ws" {
        static = {{ mqtt_websocket_port }}
      }
    }

    volume "mqtt-data" {
      type      = "host"
      source    = "mqtt-data"
      read_only = false
    }

    restart {
      attempts = 10
      interval = "5m"
      delay    = "25s"
      mode     = "delay"
    }

    {% set image_cid = mosquitto_ipfs_cid %}
    {% set image_tar_name = 'mosquitto' %}
    {% include 'load_image_task.nomad.j2' %}

    task "mosquitto" {
      driver = "containerd-driver"

      config {
        image = "eclipse-mosquitto:2"
        mounts = [
          {
            type    = "bind"
            source  = "/opt/mqtt/certs"
            target  = "/mosquitto/certs"
            options = ["rbind", "ro"]
          }
        ]
        # Host mode networking requires no port map here
        cap_add = ["SETUID", "SETGID", "CHOWN", "NET_BIND_SERVICE"]
        command = "mosquitto"
        args    = ["-c", "/mosquitto/config/mosquitto.conf"]
      }

      volume_mount {
        volume      = "mqtt-data"
        destination = "/mosquitto"
        read_only   = false
      }

      service {
        name     = "mqtt"
        port     = "mqtt"
        provider = "consul"
        address  = "${attr.unique.network.ip-address}"
        check {
          name     = "mqtt_health"
          type     = "tcp"
          interval = "10s"
          timeout  = "2s"
        }
      }

      service {
        name     = "mqtts"
        port     = "mqtts"
        provider = "consul"
        address  = "${attr.unique.network.ip-address}"
        check {
          name     = "mqtts_health"
          type     = "tcp"
          interval = "10s"
          timeout  = "2s"
        }
      }

      resources {
        cpu    = 500
        memory = 256
      }

      user = "1883"
    }
  }
}

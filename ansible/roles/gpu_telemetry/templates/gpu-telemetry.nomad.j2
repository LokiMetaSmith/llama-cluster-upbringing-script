job "gpu-telemetry" {
  datacenters = {{ nomad_datacenters | default(['dc1']) | to_json }}
  type        = "system"
  priority    = 50

  group "gpu-telemetry" {
    network {
      mode = "host"
    }

    task "gpu-telemetry-agent" {
      driver = "raw_exec"

      env {
        CONSUL_HTTP_TOKEN = "{{ consul_bootstrap_token }}"
        CONSUL_HTTP_ADDR  = "https://{{ cluster_ip | default('127.0.0.1') }}:{{ consul_https_port | default(8501) }}"
        NOMAD_NODE_ID     = "${node.unique.id}"
        NOMAD_NODE_NAME   = "${node.unique.name}"
      }

      config {
        command = "/usr/bin/python3"
        args    = ["local/gpu_telemetry.py"]
      }

      template {
        data = <<EOH
import sys
import subprocess
import json
import time
import os
import urllib.request
import urllib.error
import urllib.parse
import re

CONSUL_HTTP_ADDR = os.environ.get("CONSUL_HTTP_ADDR", "http://127.0.0.1:8500")
CONSUL_HTTP_TOKEN = os.environ.get("CONSUL_HTTP_TOKEN", "")
NODE_NAME = os.environ.get("NOMAD_NODE_NAME", "unknown")
SERVICE_NAME = "gpu-telemetry"
SERVICE_ID = f"gpu-telemetry-{NODE_NAME}"

def get_nvidia_compute_cap(gpu_name):
    name = gpu_name.lower()
    if any(x in name for x in ["rtx 50", "rtx50", "b100", "b200"]):
        return "9.0"
    elif any(x in name for x in ["rtx 40", "rtx40"]):
        return "8.9"
    elif any(x in name for x in ["rtx 30", "rtx30"]):
        return "8.6"
    return "gpu"

def get_vram_info():
    tags = []
    gpus = []

    # Try NVIDIA first
    try:
        output = subprocess.check_output(
            ["nvidia-smi", "--query-gpu=memory.free,memory.total,utilization.gpu,name", "--format=csv,nounits,noheader"],
            stderr=subprocess.DEVNULL
        ).decode('utf-8').strip()

        for line in output.split('\n'):
            parts = line.split(', ')
            if len(parts) >= 4:
                gpus.append({
                    "free_mb": int(parts[0]),
                    "total_mb": int(parts[1]),
                    "util_pct": int(parts[2]),
                    "name": parts[3]
                })
                cap = get_nvidia_compute_cap(parts[3])
                if cap != "gpu":
                    tags.append(f"gpu-cuda-{cap}")
                else:
                    tags.append("gpu-cuda")
    except Exception:
        pass

    # Fallback to AMD rocm-smi
    if not gpus:
        try:
            output = subprocess.check_output(
                ["rocm-smi", "--showmeminfo", "vram", "--showuse"],
                stderr=subprocess.DEVNULL
            ).decode('utf-8').strip()

            parsed_gpus = {}
            for line in output.split('\n'):
                match = re.search(r'GPU\[(\d+)\]', line)
                if not match:
                    continue
                idx = match.group(1)
                if idx not in parsed_gpus:
                    parsed_gpus[idx] = {"total_b": 0, "used_b": 0, "util_pct": 0}

                if "VRAM Total Memory" in line:
                    val = re.search(r':\s*(\d+)', line)
                    if val: parsed_gpus[idx]["total_b"] = int(val.group(1))
                elif "VRAM Total Used Memory" in line:
                    val = re.search(r':\s*(\d+)', line)
                    if val: parsed_gpus[idx]["used_b"] = int(val.group(1))
                elif "GPU use" in line:
                    val = re.search(r':\s*(\d+)', line)
                    if val: parsed_gpus[idx]["util_pct"] = int(val.group(1))

            for idx, data in parsed_gpus.items():
                total_mb = data["total_b"] // (1024*1024)
                used_mb = data["used_b"] // (1024*1024)
                free_mb = max(0, total_mb - used_mb)
                gpus.append({
                    "free_mb": free_mb,
                    "total_mb": total_mb,
                    "util_pct": data["util_pct"],
                    "name": "AMD GPU"
                })

            if gpus:
                tags.append("gpu-rocm")
        except Exception:
            pass

    return gpus, list(set(tags))

def get_cpu_instructions():
    tags = []
    try:
        with open('/proc/cpuinfo', 'r') as f:
            cpuinfo = f.read()

        if re.search(r'\bavx512', cpuinfo):
            tags.append("inst-avx512")
        if re.search(r'\bavx2\b', cpuinfo):
            tags.append("inst-avx2")
        if re.search(r'\bamx', cpuinfo):
            tags.append("inst-amx")
        if re.search(r'\b(asimd|neon)\b', cpuinfo):
            tags.append("inst-neon")
    except Exception:
        pass
    return tags

def get_npu_info():
    tags = []
    # Basic check for NPU devices, often exposed under /dev/accel/ or specific misc devices
    try:
        if os.path.exists('/dev/accel') and os.listdir('/dev/accel'):
            tags.append("accel-npu")
    except Exception:
        pass
    return tags

def get_hybrid_cores():
    # Attempt to extract hybrid core topology if sysfs files are present
    # This is added to metadata, not tags, as requested
    info = {"p_cores": 0, "e_cores": 0}
    try:
        # A rough heuristic for Linux: read cpu-freq max frequencies or core types if exposed
        cpu_dir = '/sys/devices/system/cpu'
        if os.path.exists(cpu_dir):
            for entry in os.listdir(cpu_dir):
                if re.match(r'^cpu\d+$', entry):
                    # For simplicity, we just stub this out for the payload
                    # In a real environment, you'd check cpufreq/cpuinfo_max_freq
                    pass
    except Exception:
        pass
    return info

def register_service(tags, meta):
    url = f"{CONSUL_HTTP_ADDR}/v1/agent/service/register"
    headers = {"Content-Type": "application/json"}
    if CONSUL_HTTP_TOKEN:
        headers["X-Consul-Token"] = CONSUL_HTTP_TOKEN

    data = {
        "Name": SERVICE_NAME,
        "ID": SERVICE_ID,
        "Tags": tags,
        "Meta": meta,
        "Check": {
            "TTL": "30s",
            "DeregisterCriticalServiceAfter": "1m"
        }
    }

    req = urllib.request.Request(url, data=json.dumps(data).encode(), headers=headers, method="PUT")
    try:
        with urllib.request.urlopen(req) as response:
            pass
    except urllib.error.URLError as e:
        print(f"Failed to register service: {e}")

def update_ttl():
    url = f"{CONSUL_HTTP_ADDR}/v1/agent/check/pass/service:{SERVICE_ID}"
    headers = {}
    if CONSUL_HTTP_TOKEN:
        headers["X-Consul-Token"] = CONSUL_HTTP_TOKEN
    req = urllib.request.Request(url, headers=headers, method="PUT")
    try:
        with urllib.request.urlopen(req) as response:
            pass
    except urllib.error.URLError as e:
        print(f"Failed to update TTL: {e}")

def main():
    while True:
        vram, gpu_tags = get_vram_info()

        tags = ["gpu-telemetry"]

        if vram:
            total_free = sum(g["free_mb"] for g in vram)
            avg_util = sum(g["util_pct"] for g in vram) // len(vram) if vram else 0
            tags.append(f"vram-free-{total_free}")
            tags.append(f"gpu-util-{avg_util}")
            tags.append("has-gpu-true")
            tags.extend(gpu_tags)

        tags.extend(get_cpu_instructions())
        tags.extend(get_npu_info())

        meta = {
            "node_name": NODE_NAME
        }

        # Optionally attach hybrid core info as raw json string for monitoring
        meta["hybrid_cores"] = json.dumps(get_hybrid_cores())

        register_service(tags, meta)
        update_ttl()

        time.sleep(15)

if __name__ == "__main__":
    main()
EOH
        destination = "local/gpu_telemetry.py"
        perms       = "755"
      }

      resources {
        cpu    = 100
        memory = 64
      }
    }
  }
}
